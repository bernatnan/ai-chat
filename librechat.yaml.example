# LibreChat Configuration - Complete Example
# This file contains ALL possible configuration
# Copy it and adapt it according to your needs

version: 1.3.14

cache: true

# Interface: cosmetic/UI settings only.
# Role permissions (prompts, agents, mcpServers, webSearch, bookmarks, etc.) are
# intentionally NOT declared here: any section present in `interface` is synced to the
# ADMIN/USER role documents on every startup, overwriting changes made from the admin
# panel. Omitting them makes the admin panel the source of truth (panel edits survive
# rebuilds). The client gates features by role permissions, so nothing is hidden.
interface:
  customWelcome: 'Welcome to LibreChat!'
  privacyPolicy:
    externalUrl: ''
    openNewTab: false
  termsOfService:
    externalUrl: ''
    openNewTab: false
  modelSelect: true
  parameters: true
  presets: true

# Cloudflare Turnstile
# IMPORTANT: Replace YOUR_SITE_KEY with your real Cloudflare Turnstile site key
# Get it at: https://dash.cloudflare.com/turnstile
turnstile:
  siteKey: 'YOUR_SITE_KEY'
  options:
    language: "ca"
    size: "normal"

registration:
  socialLogins: []
  # allowedDomains:
  #   - "yourdomain.com"

# Speech (TTS/STT)
# Note: allowedAddresses is required since the SSRF guard blocks private Docker IPs by default.
speech:
  tts:
    allowedAddresses:
      - 'localai:8080'
    localai:
      url: 'http://localai:8080/v1/audio/speech'
      apiKey: ''
      model: 'ca_ES-upc_ona-medium.onnx'
      backend: 'piper'
      voices:
        - 'ca_ES-upc_ona-medium'
        - 'ca_ES-upc_pau-medium'
        - 'es_ES-sharvard-medium'
        - 'es_ES-davefx-medium'
        - 'en_US-amy-medium'
        - 'en_US-joe-medium'
        - 'fr_FR-siwis-medium'
        - 'fr_FR-gilles-medium'
        - 'it_IT-paola-medium'
        - 'it_IT-riccardo-medium'
  stt:
    allowedAddresses:
      - 'localai:8080'
    openai:
      url: 'http://localai:8080/v1/audio/transcriptions'
      apiKey: ''
      model: 'whisper-1'
  speechTab:
    textToSpeech: true
    speechToText: true
    autoSendSpeech: true
    preferredVoice: 'ca_ES-upc_ona-medium'

# Web Search Configuration
# Note: allowedAddresses is required since the SSRF guard blocks private Docker IPs by default.
webSearch:
  allowedAddresses:
    - 'searxng:8080'
  searchProvider: searxng
  searxngInstanceUrl: '${SEARXNG_INSTANCE_URL}'
  scraperProvider: tavily
  tavilyApiKey: '${TAVILY_API_KEY}'
  rerankerType: jina
  jinaApiKey: '${JINA_API_KEY}'

endpoints:
  # Global title generation — applies to all endpoints (agents + direct chats).
  # 'completion' works with any model (no function calling required); titlePrompt
  # instructs the model to title in the conversation's own language.
  # titleEndpoint routes generation to a cheap fast model regardless of the chat model.
  all:
    titleMethod: 'completion'
    titleEndpoint: 'QwenCloud'
    titleModel: 'qwen3.6-flash'
    titlePrompt: 'Write a concise title for this conversation in the same language as the conversation. Title in 5 Words or Less. No Punctuation or Quotation.'

  agents:
    recursionLimit: 50
    maxRecursionLimit: 50
    capabilities: ["file_search", "web_search", "actions", "tools"]

  custom:
    # Anthropic (Claude)
    - name: 'Anthropic'
      apiKey: '${ANTHROPIC_API_KEY}'
      baseURL: 'https://api.anthropic.com/v1'
      models:
        default:
          - 'claude-3-5-sonnet-20241022'
          - 'claude-3-5-haiku-20241022'
          - 'claude-3-opus-20240229'
          - 'claude-3-sonnet-20240229'
          - 'claude-3-haiku-20240307'
        fetch: false
      modelDisplayLabel: 'Anthropic'

    # OpenAI
    - name: 'OpenAI'
      apiKey: '${OPENAI_API_KEY}'
      baseURL: 'https://api.openai.com/v1'
      models:
        default:
          - 'gpt-4o'
          - 'gpt-4o-mini'
          - 'gpt-4-turbo'
          - 'gpt-4'
          - 'gpt-3.5-turbo'
          - 'o1-preview'
          - 'o1-mini'
        fetch: false
      modelDisplayLabel: 'OpenAI'

    # QwenCloud Token Plan / DashScope (Alibaba Cloud) - All models
    - name: 'QwenCloud'
      apiKey: '${QWENCLOUD_KEY}'
      baseURL: 'https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1'
      # baseURL: 'https://dashscope-intl.aliyuncs.com/compatible-mode/v1'
      models:
        default:
          - 'qwen3.8-max-preview'
          - 'qwen3.7-max'
          - 'qwen3.7-plus'
          - 'qwen3.6-plus'
          - 'qwen3.6-flash'
          - 'deepseek-v4-pro'
          - 'deepseek-v4-flash'
          - 'deepseek-v3.2'
          - 'kimi-k2.7-code'
          - 'kimi-k2.6'
          - 'glm-5.2'
          - 'MiniMax-M2.5'
        fetch: false
      modelDisplayLabel: 'QwenCloud'
      dropParams: ['stop', 'user', 'frequency_penalty', 'presence_penalty']

    # QwenCloud Pay-As-You-Go / DashScope (Alibaba Cloud) - All models
    - name: 'Qwen'
      apiKey: '${QWEN_API_KEY}'
      baseURL: 'https://dashscope-intl.aliyuncs.com/compatible-mode/v1'
      models:
        default:
          - 'qwen3.7-flash'
        fetch: false
      modelDisplayLabel: 'Qwen'
      dropParams: ['stop', 'user', 'frequency_penalty', 'presence_penalty']

    # DeepSeek
    - name: 'DeepSeek'
      apiKey: '${DEEPSEEK_API_KEY}'
      baseURL: 'https://api.deepseek.com/v1'
      models:
        default:
          - 'deepseek-chat'
          - 'deepseek-reasoner'
        fetch: false
      modelDisplayLabel: 'DeepSeek'
      dropParams: ['stop', 'user', 'frequency_penalty', 'presence_penalty']

    # Zhipu AI / GLM
    - name: 'Zhipu AI'
      apiKey: '${ZHIPU_API_KEY}'
      baseURL: 'https://open.bigmodel.cn/api/paas/v4'
      models:
        default:
          - 'glm-4-plus'
          - 'glm-4-air'
          - 'glm-4-flash'
          - 'glm-4-long'
          - 'glm-4v-plus'
          - 'glm-4v'
          - 'cogview-4'
        fetch: false
      modelDisplayLabel: 'Zhipu AI'
      dropParams: ['stop', 'user', 'frequency_penalty', 'presence_penalty']

    # Ollama (local models)
    - name: 'Ollama'
      apiKey: 'ollama'
      baseURL: 'http://ollama:11434/v1/'
      models:
        default:
          - 'llama3.2'
          - 'mistral'
          - 'qwen2.5'
          - 'deepseek-r1'
          - 'codellama'
        fetch: true
      modelDisplayLabel: 'Ollama (Local)'

    # OpenRouter (multi-provider gateway)
    - name: 'OpenRouter'
      apiKey: '${OPENROUTER_KEY}'
      baseURL: 'https://openrouter.ai/api/v1'
      models:
        default:
          - 'meta-llama/llama-3.1-70b-instruct'
          - 'deepseek/deepseek-chat'
        fetch: true
      modelDisplayLabel: 'OpenRouter'
      dropParams: ['stop']

  allowedAddresses:
    - 'ollama:11434'
    - 'localhost:11434'
    - '127.0.0.1:11434'
    - 'host.docker.internal:11434'

# MCP Servers
mcpServers:
  image:
    type: stdio
    command: node
    args:
      - '/app/mcp-servers/image/index.js'
    env:
      # generate_image — Subscription (token plan)
      DASHSCOPE_API_KEY: '${QWENCLOUD_KEY}'
      DASHSCOPE_BASE_URL: 'https://token-plan.ap-southeast-1.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation'
      # edit_image — Pay-As-You-Go (qwen-image-edit is not in the token plan)
      # Falls back to the generate credentials when omitted
      DASHSCOPE_EDIT_API_KEY: '${QWEN_API_KEY}'
      DASHSCOPE_EDIT_BASE_URL: 'https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation'
      IMAGES_PATH: '/app/generated_files/'
    timeout: 120000

  image-openrouter:
    type: stdio
    command: node
    args:
      - '/app/mcp-servers/image-openrouter/index.js'
    env:
      OPENROUTER_KEY: '${OPENROUTER_KEY}'
      IMAGES_PATH: '/app/generated_files/'
    timeout: 120000

  video:
    type: stdio
    command: node
    args:
      - '/app/mcp-servers/video/index.js'
    env:
      DASHSCOPE_API_KEY: '${QWENCLOUD_KEY}'
      DASHSCOPE_API_HOST: 'https://token-plan.ap-southeast-1.maas.aliyuncs.com'
      VIDEO_API_VARIANT: 'tokenplan'
      # DASHSCOPE_API_HOST: 'https://dashscope-intl.aliyuncs.com'
      # VIDEO_API_VARIANT: 'dashscope'
    timeout: 600000

  video-openrouter:
    type: stdio
    command: node
    args:
      - '/app/mcp-servers/video-openrouter/index.js'
    env:
      OPENROUTER_KEY: '${OPENROUTER_KEY}'
    timeout: 300000

  document-generator:
    type: stdio
    command: node
    args:
      - '/app/mcp-servers/document-generator/index.js'
    env:
      DOCUMENTS_PATH: '/app/generated_files'
      DOCUMENTS_BASE_URL: '${DOMAIN_CLIENT}'
    timeout: 120000

  file-reader:
    type: stdio
    command: node
    args:
      - '/app/mcp-servers/file-reader/index.js'
    env:
      UPLOADS_ROOT: '/app/uploads'
      IMAGES_ROOT: '/app/client/public/images'
      GENERATED_ROOT: '/app/generated_files'
    timeout: 300000

actions:
  allowedDomains:
    - 'api.anthropic.com'
    - 'api.openai.com'
    - 'dashscope-intl.aliyuncs.com'
    - 'dashscope.aliyuncs.com'
    - 'api.deepseek.com'
    - 'open.bigmodel.cn'
    - 'openrouter.ai'
  allowedAddresses:
    - 'ollama:11434'
    - 'localhost:11434'
    - '127.0.0.1:11434'

# File size limits (in MB) — override the hardcoded provider defaults (e.g. 10MB for OpenAI)
# fileConfig:
#   endpoints:
#     default:
#       fileSizeLimit: 50   # applies to all endpoints
